generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Un workspace = una empresa (tenant). Toda la data de negocio cuelga de acá y
/// el acceso se otorga exclusivamente por Membership: no hay pertenencia
/// implícita por dominio de email ni por columna en User.
model Workspace {
  id             String             @id @default(uuid())
  name           String
  slug           String             @unique
  plan           String             @default("agency")
  aiProvider     String?
  /// Cifrada en reposo con AES-256-GCM (ver lib/crypto.ts). Formato
  /// `v1:iv:tag:ciphertext`; las filas anteriores a A0.6 pueden estar en texto
  /// plano y se recifran al leerlas. Descifrarla solo desde
  /// lib/workspaceSecret.ts.
  aiApiKey       String?
  aiModel        String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now()) @updatedAt
  clients        Client[]
  projects       Project[]
  users          User[]
  memberships    Membership[]
  invites        WorkspaceInvite[]
  reviewSessions ReviewSession[]
  presets        GenerationPreset[]
  generationLogs GenerationLog[]
  usagePeriods   UsagePeriod[]
  Pieza          Pieza[]
}

model User {
  id                    String            @id @default(uuid())
  email                 String            @unique
  passwordHash          String
  name                  String
  /// LEGACY. Ya no autoriza nada: el rol efectivo vive en Membership.role y se
  /// resuelve por workspace activo. Se conserva para no romper seeds y para el
  /// backfill; eliminar en una migración posterior.
  role                  Role              @default(CLIENT)
  /// LEGACY. Ya no confina la lectura: un usuario ve todas las marcas de los
  /// workspaces donde tiene membresía.
  clientId              String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  /// Workspace ACTIVO de la sesión, no una relación de pertenencia. Solo es
  /// válido si existe la Membership correspondiente; el middleware lo verifica
  /// en cada request y nunca confía en este campo por sí solo.
  workspaceId           String?
  client                Client?           @relation(fields: [clientId], references: [id])
  workspace             Workspace?        @relation(fields: [workspaceId], references: [id])
  memberships           Membership[]
  invitesSent           WorkspaceInvite[] @relation("InviteAuthor")
  createdReviewSessions ReviewSession[]
  piezasAsignadas       Pieza[]           @relation("PiezaAsignada")
  piezasCreadas         Pieza[]           @relation("PiezaAutor")
  eventosDePieza        PiezaEvento[]
  versionesSubidas      PiezaVersion[]
  hallazgosDecididos    Hallazgo[]
}

/// La única fuente de verdad de "quién puede entrar a qué workspace".
/// Un usuario puede tener membresía en varios workspaces (p. ej. un admin de
/// agencia invitado a los workspaces de sus clientes).
model Membership {
  id          String        @id @default(uuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

/// Invitación por email a un workspace. Reemplaza el auto-aprovisionamiento por
/// dominio: nadie entra a un workspace sin una invitación aceptada.
model WorkspaceInvite {
  id          String        @id @default(uuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(MEMBER)
  token       String        @unique @default(uuid())
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User          @relation("InviteAuthor", fields: [createdById], references: [id])

  @@index([workspaceId])
  @@index([email])
}

model Client {
  id                        String              @id @default(uuid())
  name                      String
  industry                  String
  logoUrl                   String?
  createdAt                 DateTime            @default(now())
  brandVoiceGuidelines      String?
  /// LEGACY. Ya no limita nada: la cuota se evalúa contra UsagePeriod. Se
  /// conserva un ciclo de despliegue porque durante el rolling deploy conviven
  /// contenedores viejos que la seleccionan; se dropea en una migración
  /// posterior junto con seedLobueno.ts y shared/lobuenoBrand.ts.
  quotaLimit                Int                 @default(100)
  /// LEGACY. Contador de por vida sin periodo: su valor no es convertible a
  /// consumo del periodo vigente y no se migra a ningún lado.
  quotaUsed                 Int                 @default(0)
  /// Override del límite del plan para esta marca. NULL = se aplica el del plan
  /// del workspace. No se backfillea desde quotaLimit: ese número cuenta
  /// generaciones, no dólares, y convertirlo sería inventar una tarifa.
  quotaCostUsdOverride      Decimal?            @db.Decimal(12, 6)
  /// Techo secundario en tokens. Sostiene el límite cuando el modelo no está en
  /// MODEL_PRICING y el proveedor no reporta costo: ahí computeCost registra 0
  /// USD y una cuota medida solo en dinero quedaría abierta.
  quotaTokensOverride       Int?
  valueProposition          String?
  voice                     String?
  brandGuidelinePdfUrl      String?
  brandGuidelineFileName    String?
  brandGuidelineExtractedAt DateTime?
  brandKeywords             String?
  brandProhibitions         String?
  brandFingerprint          Json?
  brandFingerprintAt        DateTime?
  workspaceId               String
  workspace                 Workspace           @relation(fields: [workspaceId], references: [id])
  dnaProfiles               ContentDNAProfile[]
  generationLogs            GenerationLog[]
  negativeFeedbacks         NegativeFeedback[]
  variations                SavedVariation[]
  users                     User[]
  usagePeriods              UsagePeriod[]
  piezas                    Pieza[]
}

/// Una fila por generación. Además del rastro de auditoría, es la tabla de
/// telemetría de costo: hasta B0 el costo que calcula services/pricing.ts se
/// emitía al frontend y quedaba enterrado dentro de outputJson, así que
/// responder "cuánto gastó el workspace X este mes" exigía abrir un JSON fila
/// por fila.
model GenerationLog {
  id               String   @id @default(uuid())
  clientId         String
  userId           String
  dnaProfileId     String
  platforms        String[]
  promptTokens     Int?
  completionTokens Int?
  createdAt        DateTime @default(now())
  funnelStage      String?
  spineJson        Json?
  outputJson       Json?

  /// Denormalizado desde Client: una marca puede moverse de empresa, y el gasto
  /// ya incurrido no se muda con ella. Además evita un join en cada reporte.
  /// NULLABLE de forma TRANSITORIA: la migración lo rellena para todas las
  /// filas existentes, pero el SET NOT NULL queda para una migración posterior
  /// (esta tanda es puramente aditiva). Toda escritura nueva debe pasarlo.
  workspaceId      String?
  /// NUMERIC y no Float: son montos que se suman en reportes de facturación y
  /// el error de punto flotante se acumula fila a fila.
  costUsd          Decimal? @db.Decimal(12, 6)
  cachedTokens     Int?
  cacheWriteTokens Int?
  /// Modelo del writer (resolveModel(config, false)). El mini se deriva del
  /// provider salvo override por AI_MODEL_MINI; el detalle por llamada vive en
  /// stageBreakdown.
  model            String?
  provider         String?
  /// NULL = no se sabe (fila anterior a la telemetría), distinto de false = el
  /// proveedor reportó el cobro real.
  costEstimated    Boolean?
  durationMs       Int?
  /// UsageTotal.byStage tal cual lo produce services/pricing.ts.
  stageBreakdown   Json?

  client    Client     @relation(fields: [clientId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  /// Los dos ejes de consulta del reporte: gasto de un workspace en un periodo
  /// y gasto de una marca en un periodo.
  @@index([workspaceId, createdAt])
  @@index([clientId, createdAt])
}

/// Consumo de una marca en un periodo. Reemplaza el contador de por vida
/// Client.quotaUsed, que nunca se reiniciaba. No hay cron ni job de reinicio:
/// la fila del periodo vigente se crea con un upsert en el primer uso, y un
/// periodo sin consumo simplemente no tiene fila. Las filas viejas quedan como
/// histórico facturable, así que "reiniciar la cuota" nunca es una escritura
/// destructiva.
///
/// Esta tabla mide consumo COBRABLE, no gasto bruto: una generación que falló
/// en todos los canales gastó plata real (la etapa director corre antes del
/// fan-out) pero no escribe acá. Ese gasto queda visible en GenerationLog.
/// La diferencia entre las dos es intencional; no "arreglarla" cuadrándolas.
model UsagePeriod {
  id          String    @id @default(uuid())
  workspaceId String
  clientId    String
  /// Medianoche UTC del primer día del mes. Se construye SIEMPRE con
  /// Date.UTC(y, m, 1): un `new Date(y, m, 1)` local corre la fila un mes
  /// entero en zonas negativas como la de Bogotá. Es TIMESTAMP y no DATE
  /// porque el cast de timestamp a date en Postgres depende del TimeZone de la
  /// sesión, y ahí el día 1 puede caer en el periodo anterior.
  periodStart DateTime
  /// Métrica secundaria: se reporta, no limita. Una regeneración de un canal y
  /// una campaña de catorce cuentan igual acá, y por eso no puede ser el
  /// límite.
  generations Int       @default(0)
  costUsd     Decimal   @default(0) @db.Decimal(12, 6)
  /// promptTokens + completionTokens. Es el techo que sí se puede aplicar
  /// cuando el modelo no está en MODEL_PRICING y el proveedor no reporta costo:
  /// en ese caso pricing.ts registra 0 USD y una cuota medida solo en dinero
  /// quedaría abierta.
  tokens      Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Hace atómico el upsert: dos generaciones simultáneas de la misma marca en
  /// un periodo recién estrenado no pueden crear dos filas.
  @@unique([clientId, periodStart])
  /// Techo por plan: suma del consumo de todas las marcas del workspace en el
  /// periodo, una agregación por generación.
  @@index([workspaceId, periodStart])
}

model ContentDNAProfile {
  id                   String   @id @default(uuid())
  clientId             String
  name                 String
  voice                String
  goal                 String
  product              String
  targetAudience       String
  theme                String
  keywords             String
  brandVoiceGuidelines String
  valueProposition     String
  primaryCTA           String
  createdAt            DateTime @default(now())
  feedbackExamples     Json?
  prohibitions         String?
  campaignConcept      String?
  client               Client   @relation(fields: [clientId], references: [id])
}

model SavedVariation {
  id               String              @id @default(uuid())
  clientId         String
  projectId        String?
  platform         String
  type             String
  /// Procedencia de la pieza: el id de slot que emitió el writer
  /// (p. ej. "slidesBody"). NULLABLE sin default a propósito: NULL significa
  /// "no sabemos", que es la verdad para las filas anteriores a esta migración.
  /// Un default '' las volvería indistinguibles de un dato real.
  slot             String?
  /// Etiqueta legible del slot, resuelta SIEMPRE en el servidor contra
  /// channels/registry.ts. Nunca se copia del body: el cliente no puede
  /// inventar la etiqueta de un slot.
  slotLabel        String?
  /// Cuál de las N variaciones del slot es. No es deducible para las filas
  /// viejas: el backfill lo deja en NULL en vez de numerar por fecha, que
  /// refleja el orden en que un humano fue clickeando "guardar".
  variationIndex   Int?
  /// Marca las filas cuyo slot lo dedujo el backfill heurístico por conteo de
  /// unidades contra el ChannelSpec. Es columna aparte y no un sufijo en
  /// slotLabel porque tiene que sobrevivir a cualquier edición del texto y ser
  /// consultable desde SQL. NOT NULL con default false: es una afirmación sobre
  /// el origen del dato y siempre hay una respuesta correcta.
  slotInferred     Boolean             @default(false)
  content          String
  charCount        Int
  tags             String[]
  previousVersions Json                @default("[]")
  isApproved       Boolean             @default(false)
  approvalNote     String?
  savedAt          DateTime            @default(now())
  client           Client              @relation(fields: [clientId], references: [id])
  project          Project?            @relation(fields: [projectId], references: [id])
  reviewItems      ReviewSessionItem[]
  piezaSlots       PiezaSlot[]

  /// La consulta de H2.A: todos los slots de un canal para una marca. Es el
  /// primer índice de la tabla.
  @@index([clientId, platform, slot])
}

model Project {
  id          String           @id @default(uuid())
  name        String
  createdAt   DateTime         @default(now())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id])
  variations  SavedVariation[]
  piezas      Pieza[]
}

model NegativeFeedback {
  id        String   @id @default(uuid())
  clientId  String
  platform  String
  content   String
  reason    String
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model GenerationPreset {
  id          String    @id @default(uuid())
  name        String
  workspaceId String
  clientId    String?
  parameters  Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

/// LEGACY: rol global del usuario. Conservado solo para el backfill.
enum Role {
  ADMIN
  CLIENT
}

/// Rol dentro de UN workspace. OWNER y ADMIN administran; MEMBER genera y
/// consulta pero no gestiona marcas, usuarios ni configuración.
enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model ReviewSession {
  id          String              @id @default(uuid())
  token       String              @unique @default(uuid())
  title       String
  status      ReviewSessionStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  workspaceId String
  createdById String
  workspace   Workspace           @relation(fields: [workspaceId], references: [id])
  createdBy   User                @relation(fields: [createdById], references: [id])
  items       ReviewSessionItem[]
  submission  ReviewSubmission?
}

model ReviewSessionItem {
  id               String         @id @default(uuid())
  reviewSessionId  String
  savedVariationId String
  sortOrder        Int            @default(0)
  reviewSession    ReviewSession  @relation(fields: [reviewSessionId], references: [id], onDelete: Cascade)
  savedVariation   SavedVariation @relation(fields: [savedVariationId], references: [id], onDelete: Cascade)
}

model ReviewSubmission {
  id              String               @id @default(uuid())
  reviewSessionId String               @unique
  submittedAt     DateTime             @default(now())
  reviewerName    String?
  reviewSession   ReviewSession        @relation(fields: [reviewSessionId], references: [id], onDelete: Cascade)
  feedbacks       ReviewItemFeedback[]
}

model ReviewItemFeedback {
  id                 String           @id @default(uuid())
  reviewSubmissionId String
  savedVariationId   String
  decision           ReviewDecision
  comment            String?
  reviewSubmission   ReviewSubmission @relation(fields: [reviewSubmissionId], references: [id], onDelete: Cascade)
}

enum ReviewSessionStatus {
  PENDING
  IN_REVIEW
  COMPLETED
}

enum ReviewDecision {
  APPROVED
  REJECTED
}

/// Las cuatro columnas de D5, cada una con su dueño y la acción que la vacía.
/// "En auditoría" NO es un estado: dura minutos, la mueve el sistema y nadie
/// puede desatascarla (ver docs/plan-h2-produccion-auditoria.md).
enum PiezaEstado {
  POR_ASIGNAR
  EN_DISENO
  POR_REVISAR
  LISTA
}

/// Lo declara el spec del canal (channels/types.ts, campo `pieza`), no la
/// campaña: un canal produce siempre la misma clase de entregable, y hay
/// canales que no producen ninguno.
enum PiezaTipo {
  GRAFICA
  VIDEO
  AUDIO
}

/// Una pieza es UN canal y UN archivo (estado límite 1). El mismo visual para
/// Post e Historia son dos piezas hermanas —mismo `grupoId`—, no una pieza con
/// dos canales: si fuera una sola, la auditoría no sabría contra qué copy
/// comparar.
model Pieza {
  id          String      @id @default(uuid())
  /// Denormalizado desde Client, igual que en GenerationLog: el guard de
  /// tenancy y el tablero filtran por acá sin join, y una marca que se mueva de
  /// empresa no arrastra el trabajo ya hecho.
  workspaceId String
  clientId    String
  /// La campaña es OPCIONAL porque SavedVariation.projectId lo es: exigirla
  /// dejaría fuera de producción todo el copy guardado sin proyecto.
  projectId   String?
  /// Valor del enum Platform ("Instagram Post"). Su spec dice tipo y formatos.
  platform    String
  tipo        PiezaTipo
  /// Uno de spec.pieza.formatos ("1080×1080"). No cambia después del alta: la
  /// unicidad de PiezaSlot depende de eso.
  formato     String
  titulo      String
  /// Huella del contenido de la pieza: formato + los aprobados que la componen,
  /// ordenados. Existe para que la BASE impida la pieza repetida —el doble
  /// clic, los dos que mandan a producir el mismo lote— sin impedir el A/B,
  /// donde dos piezas del mismo formato comparten el cuerpo y difieren en el
  /// hook. La unicidad es del CONJUNTO, no de cada copy por separado.
  huella      String
  estado      PiezaEstado @default(POR_ASIGNAR)
  /// Crear y asignar son dos decisiones: una pieza nace sin dueño, en
  /// Por asignar, y la segunda decisión es del dueño de esa columna (D7).
  asignadaAId String?
  /// Piezas hermanas: el mismo visual en dos canales. Es un uuid compartido y
  /// no una tabla, porque no tiene datos propios.
  grupoId     String?
  /// El entregable de la fase 2 —y el de los canales de video para siempre:
  /// con el tope de 10 MB de D6 un reel no entra (estado límite 4).
  enlace      String?
  creadaPorId String
  /// Cuándo entró al estado actual. Es el dato que responde "cuánto lleva esto
  /// acá", que es la pregunta que se le hace a un tablero.
  estadoDesde DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id])
  client    Client         @relation(fields: [clientId], references: [id])
  project   Project?       @relation(fields: [projectId], references: [id])
  asignadaA User?          @relation("PiezaAsignada", fields: [asignadaAId], references: [id])
  creadaPor User           @relation("PiezaAutor", fields: [creadaPorId], references: [id])
  slots     PiezaSlot[]
  eventos   PiezaEvento[]
  versiones PiezaVersion[]

  /// Los dos ejes del tablero: por marca (la pantalla) y por persona (Mis piezas).
  @@unique([workspaceId, huella])
  @@index([workspaceId, clientId, estado])
  @@index([asignadaAId, estado])
  @@index([grupoId])
}

/// El copy aprobado que va adentro de la pieza, congelado.
model PiezaSlot {
  id               String  @id @default(uuid())
  piezaId          String
  /// SetNull y no Cascade: borrar un copy de la Biblioteca no puede borrar una
  /// pieza que está en producción. NULL significa "el original ya no existe", y
  /// la tarjeta lo dice.
  /// Un mismo aprobado puede estar en varias piezas a propósito: otro formato
  /// de Display (D7), o la otra mitad de un A/B, donde las dos piezas comparten
  /// el cuerpo y solo cambia el hook. Lo que no puede repetirse es la pieza
  /// entera, y de eso se ocupa Pieza.huella.
  savedVariationId String?
  slot             String
  /// Resuelto SIEMPRE con resolveSlotLabel del registry, nunca copiado del body.
  slotLabel        String
  /// El texto tal como estaba al crearse la pieza. La auditoría compara contra
  /// esto y no contra el original: si alguien edita el copy mientras el
  /// diseñador trabaja, la pieza sigue siendo la que se mandó a producir
  /// (estado límite 3).
  textoCongelado   String
  /// visualBrief, animationBrief, structure, production: van a la orden de
  /// trabajo como brief, pero no se auditan contra la pieza — no son texto que
  /// deba aparecer en el arte.
  esInstruccion    Boolean @default(false)
  orden            Int     @default(0)

  pieza          Pieza           @relation(fields: [piezaId], references: [id], onDelete: Cascade)
  savedVariation SavedVariation? @relation(fields: [savedVariationId], references: [id], onDelete: SetNull)

  @@index([piezaId])
  @@index([savedVariationId])
}

/// Historial append-only de la pieza. No es auditoría de sistema: es lo que
/// responde "quién decidió esto y por qué" —el motivo de una devolución, la
/// nota de quien aceptó con hallazgos (D2)— y lo que permite medir cuánto
/// tiempo pasa una pieza en cada columna.
model PiezaEvento {
  id        String       @id @default(uuid())
  piezaId   String
  /// CREADA · ASIGNADA · ENTREGADA · ACEPTADA · DEVUELTA · REABIERTA · COPY_ACTUALIZADO
  tipo      String
  deEstado  PiezaEstado?
  aEstado   PiezaEstado?
  autorId   String
  /// Obligatoria en DEVUELTA y REABIERTA; el servicio lo exige.
  nota      String?
  createdAt DateTime     @default(now())

  pieza Pieza @relation(fields: [piezaId], references: [id], onDelete: Cascade)
  autor User  @relation(fields: [autorId], references: [id])

  @@index([piezaId, createdAt])
}

/// En qué quedó la auditoría de una versión. Los tres son estados distintos y
/// se muestran distinto (docs/plan-h2-produccion-auditoria.md, D2 y D3):
///   PENDIENTE     — se subió y todavía no corrió.
///   COMPLETA      — corrió y dejó sus hallazgos, aunque sean cero.
///   NO_DISPONIBLE — el proveedor falló. NO es "sin hallazgos": no miró nada,
///                   y por eso no cuenta en las métricas de acierto.
enum AuditoriaEstado {
  PENDIENTE
  COMPLETA
  NO_DISPONIBLE
}

/// Qué clase de cosa encontró la auditoría. La distinción es el corazón del
/// informe: HECHO se compara contra una verdad conocida —el texto congelado— y
/// muestra los dos lados; JUICIO es una opinión del mismo tipo que el Critic.
/// Mezclarlos en una sola lista destruye la confianza en el primero.
///   MEDIDAS — la pieza no mide lo que pedía el canal. Es un hecho, y no
///             bloquea: se sube igual y alguien decide (estado límite 4).
///   ILEGIBLE — no se pudo leer un texto. NO significa que esté mal.
enum HallazgoTipo {
  HECHO
  JUICIO
  MEDIDAS
  ILEGIBLE
}

/// Qué hizo la persona con el hallazgo. Guardarlo es obligatorio y es la razón
/// por la que D2 puede, algún día, darle autoridad a la auditoría: sin esta
/// columna nunca se sabría si acierta.
enum HallazgoDecision {
  PENDIENTE
  ACEPTADO
  CORREGIDO
}

/// Cada entrega de una pieza. Son versiones y no una sola fila porque devolver
/// a diseño y volver a subir es el camino normal, y el informe de la v1 tiene
/// que sobrevivir a la v2: es lo que permite ver si el hallazgo se corrigió.
model PiezaVersion {
  id                 String          @id @default(uuid())
  piezaId            String
  numero             Int
  /// `piezas/originales/…` — lo borra a los 90 días la regla de ciclo de vida
  /// del bucket (D6). Por eso puede quedar en NULL sin que la fila mienta.
  claveOriginal      String?
  /// `piezas/snapshots/…` — JPG de 1.600 px de lado largo, permanente. Pesa
  /// ~1 % del original y se paga solo dos veces: es también la miniatura del
  /// tablero.
  claveSnapshot      String?
  anchoPx            Int?
  altoPx             Int?
  pesoBytes          Int?
  contentType        String?
  estadoAuditoria    AuditoriaEstado @default(PENDIENTE)
  /// Por qué no corrió, cuando el estado es NO_DISPONIBLE.
  motivoNoDisponible String?
  auditadaAt         DateTime?
  /// Costo de auditar esta versión, medido como una etapa más del motor.
  costoUsd           Decimal?        @db.Decimal(12, 6)
  modelo             String?
  subidaPorId        String
  createdAt          DateTime        @default(now())

  pieza     Pieza      @relation(fields: [piezaId], references: [id], onDelete: Cascade)
  subidaPor User       @relation(fields: [subidaPorId], references: [id])
  hallazgos Hallazgo[]

  @@unique([piezaId, numero])
  @@index([piezaId, createdAt])
}

model Hallazgo {
  id             String           @id @default(uuid())
  piezaVersionId String
  tipo           HallazgoTipo
  /// Contra qué slot se encontró, cuando aplica. Un juicio de marca sobre la
  /// pieza entera no tiene slot.
  slot           String?
  slotLabel      String?
  /// Solo en HECHO: los dos lados de la comparación, para mostrarlos juntos.
  esperado       String?
  encontrado     String?
  detalle        String
  decision       HallazgoDecision @default(PENDIENTE)
  notaDecision   String?
  decididoPorId  String?
  decididoAt     DateTime?

  version     PiezaVersion @relation(fields: [piezaVersionId], references: [id], onDelete: Cascade)
  decididoPor User?        @relation(fields: [decididoPorId], references: [id])

  @@index([piezaVersionId])
}
