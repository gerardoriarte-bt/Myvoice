generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id         String    @id @default(uuid())
  name       String
  slug       String    @unique
  plan       String    @default("agency")
  aiProvider String?
  aiApiKey   String?
  aiModel    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  clients    Client[]
  projects   Project[]
  users      User[]
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role       @default(CLIENT)
  clientId     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  workspaceId  String?
  client       Client?    @relation(fields: [clientId], references: [id])
  workspace    Workspace? @relation(fields: [workspaceId], references: [id])
}

model Client {
  id                        String              @id @default(uuid())
  name                      String
  industry                  String
  logoUrl                   String?
  createdAt                 DateTime            @default(now())
  brandVoiceGuidelines      String?
  quotaLimit                Int                 @default(100)
  quotaUsed                 Int                 @default(0)
  valueProposition          String?
  voice                     String?
  brandGuidelinePdfUrl      String?
  brandGuidelineFileName    String?
  brandGuidelineExtractedAt DateTime?
  brandKeywords             String?
  brandProhibitions         String?
  brandFingerprint          Json?
  brandFingerprintAt        DateTime?
  workspaceId               String?
  workspace                 Workspace?          @relation(fields: [workspaceId], references: [id])
  dnaProfiles               ContentDNAProfile[]
  generationLogs            GenerationLog[]
  negativeFeedbacks         NegativeFeedback[]
  variations                SavedVariation[]
  users                     User[]
}

model GenerationLog {
  id               String   @id @default(uuid())
  clientId         String
  userId           String
  dnaProfileId     String
  platforms        String[]
  promptTokens     Int?
  completionTokens Int?
  createdAt        DateTime @default(now())
  funnelStage      String?
  spineJson        Json?
  outputJson       Json?
  client           Client   @relation(fields: [clientId], references: [id])
}

model ContentDNAProfile {
  id                   String   @id @default(uuid())
  clientId             String
  name                 String
  voice                String
  goal                 String
  product              String
  targetAudience       String
  theme                String
  keywords             String
  brandVoiceGuidelines String
  valueProposition     String
  primaryCTA           String
  createdAt            DateTime @default(now())
  feedbackExamples     Json?
  prohibitions         String?
  campaignConcept      String?
  client               Client   @relation(fields: [clientId], references: [id])
}

model SavedVariation {
  id           String   @id @default(uuid())
  clientId     String
  projectId    String?
  platform     String
  type         String
  content      String
  charCount    Int
  tags         String[]
  isApproved   Boolean  @default(false)
  approvalNote String?
  savedAt      DateTime @default(now())
  client       Client   @relation(fields: [clientId], references: [id])
  project      Project? @relation(fields: [projectId], references: [id])
}

model Project {
  id          String           @id @default(uuid())
  name        String
  createdAt   DateTime         @default(now())
  workspaceId String?
  workspace   Workspace?       @relation(fields: [workspaceId], references: [id])
  variations  SavedVariation[]
}

model NegativeFeedback {
  id        String   @id @default(uuid())
  clientId  String
  platform  String
  content   String
  reason    String
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  CLIENT
}
