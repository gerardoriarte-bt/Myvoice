// CDM (F2): la biblioteca de medios. Es de la agencia (el workspace), general para todas sus marcas
// (decisiones 25 y 28). Ver docs/ecosistema/datos/arquitectura-de-datos.md y docs/ecosistema/cdm/biblioteca/.

/// Un medio queda en BORRADOR hasta que Planning lo activa; en borrador no se elige en un planning.
enum EstadoMedio {
  BORRADOR
  ACTIVO
  OCULTO
}

/// Decisión 29: el proceso es el mismo para todas; cambia quién publica al final (⑤): el trafficker monta los
/// pagos, el community manager publica lo orgánico, lo propio se programa en el CRM, lo tradicional se entrega.
enum ClaseDeMedio {
  PAGOS
  REDES_SOCIALES
  PROPIOS
  TRADICIONAL
}

enum TipoDeArchivo {
  IMAGEN
  VIDEO
  AUDIO
  TEXTO
  HTML
}

/// Dónde va un texto: en la pieza (lo diseña Producción), en la plataforma (lo pone quien publica) o es una
/// indicación para Diseño que no se publica (la idea visual, la estructura de un reel).
enum ZonaDeCampo {
  PIEZA
  PLATAFORMA
  INDICACION
}

/// Meta, Google, TikTok… El nombre es único dentro de la agencia.
model Medio {
  id          String       @id @default(uuid())
  workspaceId String
  nombre      String
  /// La clase del medio (decisión 29). Los medios cargados antes de la decisión son pagos (Meta Ads).
  clase       ClaseDeMedio @default(PAGOS)
  estado      EstadoMedio  @default(BORRADOR)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  formatos  Formato[]

  @@unique([workspaceId, nombre])
}

/// La **pieza maestra** (decisión 18): un tipo de archivo y una proporción, con las ubicaciones que cubre.
/// Diseño produce por pieza; Planning planea por ubicación. Lo que cambia vive en sus versiones.
model Formato {
  id          String        @id @default(uuid())
  workspaceId String
  medioId     String
  /// «Imagen 9:16». Único dentro del medio.
  nombre      String
  tipoArchivo TipoDeArchivo
  proporcion  String?
  /// El puente con My Voice: el valor de `Platform` cuando el formato es uno de los 14 canales de hoy.
  canal       String?
  createdAt   DateTime      @default(now())

  medio            Medio             @relation(fields: [medioId], references: [id], onDelete: Cascade)
  versiones        FormatoVersion[]
  lineasDePlanning LineaDePlanning[]

  @@unique([medioId, nombre])
  @@index([workspaceId])
}

/// Una versión congela medidas, archivo, guía, ubicaciones y campos de texto. Cambiar cualquiera crea otra;
/// lo ya escrito sigue con la suya (regla 4 de la arquitectura).
model FormatoVersion {
  id          String    @id @default(uuid())
  formatoId   String
  numero      Int
  anchoPx     Int?
  altoPx      Int?
  /// «JPG o PNG», tal como lo dice la guía del medio.
  archivos    String?
  pesoMaximo  String?
  /// Lienzo y zona segura como datos, para dibujarla a escala (Producción, auditoría).
  guia        Json?
  /// De dónde salió: la planilla o la guía, con su fecha.
  fuente      String?
  fuenteFecha DateTime?
  cargaId     String?
  createdAt   DateTime  @default(now())

  formato          Formato           @relation(fields: [formatoId], references: [id], onDelete: Cascade)
  carga            CargaDePlanilla?  @relation(fields: [cargaId], references: [id], onDelete: SetNull)
  ubicaciones      Ubicacion[]
  campos           CampoDeTexto[]
  lineasDePlanning LineaDePlanning[]

  @@unique([formatoId, numero])
}

enum RevisionDeUbicacion {
  VALIDADA
  CON_OBSERVACION
}

/// Dónde aparece la pieza (Feed de Instagram, Facebook Reels…), con lo que la guía dice de cada una.
model Ubicacion {
  id               String  @id @default(uuid())
  formatoVersionId String
  plataforma       String
  nombre           String
  orden            Int
  /// Lo que pide la guía, como lo dice: «1,91:1 a 1:1».
  proporcion       String
  resolucion       String?
  /// Mínimos, tolerancia, duración, video, subtítulos, sonido y otras indicaciones de la guía.
  detalles         Json?
  zonaSegura       Json?
  urlFuente        String?
  /// Una ubicación con alerta queda «por confirmar» hasta que alguien la pruebe (meta.md, regla 3).
  alerta           Int?
  alertaTexto      String?
  porConfirmar     Boolean @default(false)
  /// El equipo la valida en la Biblioteca (2026-11-25): la planilla de Google y DV360 llegó sin validar. NULL = sin
  /// revisar; una nota dice qué está mal. Quién, por id: el nombre se lee al mostrarla. Una versión nueva la
  /// hereda si la ubicación no cambió.
  revision         RevisionDeUbicacion?
  revisionNota     String?
  revisadaPorId    String?
  revisadaEn       DateTime?

  version FormatoVersion @relation(fields: [formatoVersionId], references: [id], onDelete: Cascade)
  campos  CampoDeTexto[]

  @@index([formatoVersionId])
}

/// Un texto que lleva la pieza o la plataforma. Con `ubicacionId`, su largo es el de esa ubicación: el
/// planning escribe para el más corto entre las que eligió la línea (decisión 18).
model CampoDeTexto {
  id               String      @id @default(uuid())
  formatoVersionId String
  ubicacionId      String?
  clave            String
  nombre           String
  zona             ZonaDeCampo
  unidad           String      @default("caracteres")
  minimo           Int?
  maximo           Int?
  repeticiones     Int         @default(1)
  /// El orden en que se escriben y se muestran: el del spec o la planilla («Slide 2» antes que «Slide 10»).
  orden            Int         @default(0)

  version   FormatoVersion @relation(fields: [formatoVersionId], references: [id], onDelete: Cascade)
  ubicacion Ubicacion?     @relation(fields: [ubicacionId], references: [id], onDelete: Cascade)

  @@index([formatoVersionId])
}

/// Cada carga de una planilla, con lo que creó y cambió: el historial de la biblioteca.
model CargaDePlanilla {
  id          String   @id @default(uuid())
  workspaceId String
  archivo     String
  medio       String
  resumen     Json
  autorId     String?
  createdAt   DateTime @default(now())

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versiones FormatoVersion[]

  @@index([workspaceId])
}

// ------------------------------------------------------------------------------------------ planning (F3)

/// Las etapas del funnel en que sale una línea (decisión 19). My Voice las lee como `FunnelStage` (F4).
enum EtapaDeFunnel {
  RECONOCIMIENTO
  CONSIDERACION
  CONVERSION
  RETENCION
}

/// Sin enviar (en armado o devuelto), por aprobar o aprobado (decisión 20: el menú cuenta los dos últimos).
enum EstadoPlanning {
  EN_ARMADO
  POR_APROBAR
  DEVUELTO
  APROBADO
  /// F3b: el responsable la aprobó y, como la campaña es «con cliente», falta el cliente por enlace.
  CON_EL_CLIENTE
}

/// El planning de una campaña (P1 a P5): uno por campaña, que se crea antes (decisión 24). Cada envío sube la
/// versión; las líneas se editan solo sin enviar o devuelto, y un planning aprobado se reabre como versión nueva.
model Planning {
  id          String          @id @default(uuid())
  workspaceId String
  clientId    String
  campanaId   String          @unique
  version     Int             @default(1)
  estado      EstadoPlanning  @default(EN_ARMADO)
  desde       DateTime?
  hasta       DateTime?
  etapas      EtapaDeFunnel[]
  creadoPorId String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  campana         Project             @relation(fields: [campanaId], references: [id], onDelete: Cascade)
  lineas          LineaDePlanning[]
  eventos         EventoDePlanning[]
  itemsDeRevision ReviewSessionItem[]

  @@index([workspaceId, clientId])
}

/// Una línea de la sábana = un formato en una etapa, con sus piezas (decisión 19). Su `id` es el `lineaId`
/// estable entre versiones: My Voice compara por él (F4).
model LineaDePlanning {
  id               String        @id @default(uuid())
  planningId       String
  formatoId        String
  /// La versión del formato con que se planeó: lo escrito después sigue con ella (regla 4).
  formatoVersionId String
  etapa            EtapaDeFunnel
  piezas           Int
  desde            DateTime?
  hasta            DateTime?
  /// Las ubicaciones que eligió la línea (P4b, F3b): el largo para My Voice es el más corto entre ellas.
  ubicacionIds     String[]      @default([])
  /// F5 (P6): adónde lleva el anuncio y su UTM. Los pega Planning cuando los tiene, sin versión nueva de la sábana.
  /// El destino es obligatorio para montar; la UTM solo avisa (decisión 20).
  destino          String?
  utm              String?
  /// Marcado a propósito: este anuncio no lleva URL (2026-11-24). Sin destino ni esta marca, no se puede aprobar.
  sinDestino       Boolean       @default(false)
  orden            Int           @default(0)

  planning Planning       @relation(fields: [planningId], references: [id], onDelete: Cascade)
  formato  Formato        @relation(fields: [formatoId], references: [id])
  version  FormatoVersion @relation(fields: [formatoVersionId], references: [id])

  @@unique([planningId, formatoId, etapa])
}

enum TipoEventoPlanning {
  CREADO
  ENVIADO
  APROBADO
  DEVUELTO
  REABIERTO
  /// F3b: la ronda del cliente por enlace. El autor es quien mandó el enlace; el nombre del cliente va en
  /// el comentario.
  ENVIADO_AL_CLIENTE
  APROBADO_POR_CLIENTE
  DEVUELTO_POR_CLIENTE
}

/// El historial del planning: no se edita (regla 5 del plan). Un «devuelto» lleva su comentario.
model EventoDePlanning {
  id         String             @id @default(uuid())
  planningId String
  tipo       TipoEventoPlanning
  version    Int
  autorId    String
  comentario String?
  createdAt  DateTime           @default(now())

  planning Planning @relation(fields: [planningId], references: [id], onDelete: Cascade)

  @@index([planningId])
}
